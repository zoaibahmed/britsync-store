  @@unique([reviewId, userId])
}

// =========================================================================
// 12. MANAGED COMMERCE OPERATIONS & BESPOKE ECOSYSTEM
// =========================================================================

model CustomCommission {
  id                    String    @id @default(uuid())
  patronUserId          String
  categoryId            String?
  assignedMakerProfileId String?
  title                 String    @db.VarChar(255)
  description           String    @db.Text
  budgetGbp             Float?
  dimensions            String?   @db.VarChar(255)
  materials             String?   @db.Text
  deadline              DateTime?
  status                String    @default("SUBMITTED") @db.VarChar(50) // SUBMITTED, CONCIERGE_REVIEW, STUDIO_ROUTED, QUOTED, ACCEPTED, REJECTED, IN_PRODUCTION, COMPLETED
  quoteAmountGbp        Float?
  orderId               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([patronUserId])
  @@index([assignedMakerProfileId])
  @@index([status])
}

model PayoutRequest {
  id                     String    @id @default(uuid())
  makerProfileId         String
  amount                 Float
  status                 String    @default("REQUESTED") @db.VarChar(50) // REQUESTED, PROCESSING, PAID, REJECTED
  payoutMethod           String    @db.VarChar(50) // STRIPE_CONNECT, WISE, BANK_WIRE
  accountDetailsEncrypted String?  @db.Text
  rejectionReason        String?   @db.Text
  requestedAt            DateTime  @default(now())
  processedAt            DateTime?
  processedByUserId      String?

  @@index([makerProfileId])
  @@index([status])
}

model OperationTask {
  id             String    @id @default(uuid())
  taskType       String    @db.VarChar(50) // ACCREDITATION_REVIEW, INSPECTION_ASSIGNED, CATALOG_MODERATION, PAYOUT_APPROVAL, DISPATCH_OVERDUE, DISPUTE_OPEN, COMMISSION_REQUEST
  targetRole     String    @db.VarChar(50) // CEO, ACCREDITATION_OFFICER, INSPECTOR, CATALOG_CURATOR, FINANCE_OFFICER, FULFILLMENT_OFFICER, CONCIERGE, PROVENANCE_OFFICER, BI_OFFICER
  referenceId    String    @db.VarChar(255)
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  priority       String    @default("MEDIUM") @db.VarChar(20) // LOW, MEDIUM, HIGH, URGENT
  status         String    @default("OPEN") @db.VarChar(20) // OPEN, IN_PROGRESS, RESOLVED
  dueDate        DateTime?
  assignedUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([targetRole, status])
  @@index([priority])
}

model InternalNote {
  id           String   @id @default(uuid())
  targetType   String   @db.VarChar(50) // MAKER, PRODUCT, ORDER, PATRON, DISPUTE, APPLICATION
  targetId     String   @db.VarChar(255)
  authorUserId String
  authorRole   String   @db.VarChar(50)
  noteText     String   @db.Text
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
}

model OrderDispute {
  id                String    @id @default(uuid())
  orderId           String
  raisedByUserId    String
  issueType         String    @db.VarChar(50) // DAMAGED, NOT_RECEIVED, DIFFERENT_THAN_LISTED, SHIPPING_DELAY, REFUND_REQUEST
  description       String    @db.Text
  status            String    @default("OPEN") @db.VarChar(50) // OPEN, UNDER_REVIEW, RESOLUTION_PROPOSED, RESOLVED, CLOSED
  resolutionSummary String?   @db.Text
  refundAmount      Float?
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime  @default(now())

  @@index([orderId])
  @@index([status])
}

