  maker              MakerProfile     @relation(fields: [makerProfileId], references: [id], onDelete: Cascade)
  notes              String?          @db.Text
  qualityScore       Int
  latitude           Float?
  longitude          Float?
  digitalSignature   String           @db.VarChar(255)
  images             String?          @db.Text // JSON string list of urls
  videos             String?          @db.Text // JSON string list of urls
  status             String           @default("PENDING") @db.VarChar(50)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

