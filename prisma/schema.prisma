  createdAt    DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String   @db.VarChar(255)
  description String   @db.Text
  status      String   @default("OPEN") @db.VarChar(50) // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") @db.VarChar(50) // LOW, MEDIUM, HIGH, URGENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies SupportTicketReply[]
}

model VerificationRequest {
  id                 String            @id @default(uuid())
  makerProfileId     String
  maker              MakerProfile      @relation(fields: [makerProfileId], references: [id], onDelete: Cascade)
  inspectorProfileId String?
  inspector          InspectorProfile? @relation(fields: [inspectorProfileId], references: [id], onDelete: SetNull)
  status             String            @default("PENDING") @db.VarChar(50) // PENDING, INSPECTOR_ASSIGNED, AUDITED, APPROVED, REJECTED
