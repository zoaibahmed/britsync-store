  certificateNumber String       @unique
  certificateType   String       @default("ELITE") @db.VarChar(50)
  issueDate         DateTime     @default(now())
  expiryDate        DateTime
  pdfUrl            String?      @db.VarChar(512)
  createdAt         DateTime     @default(now())
}

model SavedMaker {
